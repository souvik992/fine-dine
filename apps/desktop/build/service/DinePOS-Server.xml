<!--
  WinSW 2.12 service definition for the DinePOS outlet server (master PC only).
  WinSW is installed beside this file as DinePOS-Server.exe and reads DinePOS-Server.xml.
  %BASE% is this folder (…\DinePOS\resources\server); environment variables are expanded by WinSW.
-->
<service>
  <id>DinePOSServer</id>
  <name>DinePOS Outlet Server</name>
  <description>DinePOS outlet server: the single database writer, HTTP and WebSocket API on port 7420, print queue.</description>

  <executable>%BASE%\node.exe</executable>
  <arguments>"%BASE%\server.mjs"</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <env name="NODE_ENV" value="production"/>
  <env name="DATA_DIR" value="%ProgramData%\DinePOS"/>
  <env name="DINEPOS_HOST" value="0.0.0.0"/>
  <env name="DINEPOS_PORT" value="7420"/>
  <env name="DINEPOS_TIMEZONE" value="Asia/Kolkata"/>

  <!-- Starts at boot, before anyone signs in. -->
  <startmode>Automatic</startmode>

  <!-- Crash recovery: restart after 5 s, 10 s, then every 30 s; the counter resets after an hour of running. -->
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>

  <!-- Stop sends Ctrl+C: the server finishes the ticket being printed, checkpoints the database and releases its lock. -->
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>

  <logpath>%ProgramData%\DinePOS\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>

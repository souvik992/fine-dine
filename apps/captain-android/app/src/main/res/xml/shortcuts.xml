<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon › "Change the main PC": the setup screen (there is no menu over the captain page). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup_short"
        android:shortcutLongLabel="@string/shortcut_setup_long">
        <intent
            android:action="com.dinepos.captain.SETUP"
            android:targetPackage="com.dinepos.captain"
            android:targetClass="com.dinepos.captain.MainActivity" />
    </shortcut>
</shortcuts>
